{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "shared/**"
    }
  },
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api?__path=/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?__path=/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/api?__path=/llms.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api?__path=/uploads/$1"
    },
    {
      "source": "/((?!api$|api/|uploads/|images/|audio/|assets/|robots\\.txt|sitemap\\.xml|llms\\.txt|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
