{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "shared/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api?__path=/uploads/$1"
    },
    {
      "source": "/((?!api$|api/|uploads/|images/|audio/|assets/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
